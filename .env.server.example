# Copy to .env.server locally or use your host's encrypted environment settings.
# This file is never a client build input and .env.server is ignored by Git/Docker.
HOST=127.0.0.1
PORT=8765
DATA_FILE=server/data/projects.json
# SQLite remains primary until PostgreSQL administrator/service parity is complete.
# Database credentials live only in .env.supabase, never EXPO_PUBLIC_* variables.
WEB_ORIGIN=http://127.0.0.1:8765
PUBLIC_APP_URL=http://127.0.0.1:8765
AUTH0_ISSUER=
AUTH0_AUDIENCE=
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
AUTH0_PASSWORD_CLIENT_ID=
AUTH0_EMAIL_CONNECTION=Username-Password-Authentication
INVITATION_DAYS=7
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT=buildwatch_plus
BILLING_ENABLED=false
BILLING_ALLOW_SANDBOX=false
PUSH_DELIVERY_ENABLED=false
EXPO_ACCESS_TOKEN=
PRIVACY_URL=
TERMS_URL=
