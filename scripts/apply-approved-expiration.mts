/** Explicitly requested initial archive cleanup. No permanent deletion and no recurring job. */
import{DatabaseSync,backup}from'node:sqlite';import{mkdirSync,readFileSync,writeFileSync,chmodSync}from'node:fs';import{createHash,randomUUID}from'node:crypto';
import{Store}from'../server/accounts/store';import{ArchiveService}from'../server/archives/service';import{policyValues}from'../server/archives/policy';import{enforceExpiration,enforcePermitOnly}from'../server/archives/schema';
if(!process.argv.includes('--apply-archive-cleanup'))throw Error('Pass --apply-archive-cleanup. No permanent deletion is supported by this script.');
const file=process.env.DATA_FILE||'server/data/projects.json',raw=new DatabaseSync(file+'.sqlite',{readOnly:true}),digest=(db:DatabaseSync,table:string)=>createHash('sha256').update(JSON.stringify(db.prepare(`SELECT * FROM ${table} ORDER BY rowid`).all())).digest('hex');
const tables=['projects','users','follows','follow_history','history','entitlements','invitations','submissions','notifications','devices','role_audit','duplicate_candidates','duplicate_decisions','project_relationships','classification_review_candidates'];
const hashes=Object.fromEntries(tables.map(t=>[t,digest(raw,t)]));const beforeRecords=(raw.prepare('SELECT count(*) AS n FROM projects').get() as any).n,publicBefore=(raw.prepare('SELECT count(*) AS n FROM map_index').get() as any).n,inReviewBefore=(raw.prepare("SELECT count(*) AS n FROM map_index WHERE status='In review'").get() as any).n;
mkdirSync('server/data/backups',{recursive:true,mode:0o700});const saved='server/data/backups/approved-and-permit-cleanup-'+Date.now()+'.sqlite';await backup(raw,saved);chmodSync(saved,0o600);raw.close();
const store=new Store(file+'.sqlite',file),service=new ArchiveService(store),report=JSON.parse(readFileSync('reports/approved-expiration/evidence.json','utf8')),id=randomUUID(),now=Date.now();
try{const existing=store.one('SELECT id FROM expiration_cleanups LIMIT 1');if(existing)throw Error('Initial cleanup was already recorded. Use administrator controls for subsequent changes.');
 const result=store.tx(()=>{for(const item of report.items){const project=store.originalProject(item.projectId);if(!project||project.status!=='Approved')continue;const v=policyValues(item.approval||null,item.schedules||[],now);store.run('INSERT INTO approval_policy VALUES(?,?,?,?,?,?,?,?,?,?,?) ON CONFLICT(project_id) DO UPDATE SET approval_date=excluded.approval_date,approval_at=excluded.approval_at,approval_evidence=excluded.approval_evidence,schedules=excluded.schedules,exception_until=excluded.exception_until,expires_at=excluded.expires_at,due_at=excluded.due_at,review_reason=excluded.review_reason,actor=excluded.actor,updated=excluded.updated',project.id,item.approval?.date||null,v.approvalAt,item.approval?JSON.stringify(item.approval):null,JSON.stringify(item.schedules||[]),v.exceptionUntil,v.expiresAt,v.dueAt,v.reviewReason,'operator:requested-cleanup',now);}
 let supportingPermits=0,expiredApproved=0,n=0;do{n=enforcePermitOnly(store.db,now,500,'operator:requested-stormwater-cleanup',id);supportingPermits+=n;}while(n);do{n=enforceExpiration(store.db,now,500,'operator:requested-approved-expiration',id);expiredApproved+=n;}while(n);
 const after=service.stats(),statistics={beforeRecords,publicBefore,publicAfter:after.publicProjects,expiredApproved,supportingPermits,approvedArchived:expiredApproved+supportingPermits,approvedRetained:after.approvedPublic,futureExceptions:after.futureExceptions,approvedMissingDate:after.approvedMissingDate,inReviewBefore,inReviewAfter:after.inReviewPublic,totalArchived:after.archivedRecords,storedRecordsAfter:after.storedRecords};
 if(inReviewBefore!==after.inReviewPublic)throw Error('In Review visibility changed; cleanup rolled back.');for(const t of tables)if(digest(store.db,t)!==hashes[t])throw Error(t+' changed unexpectedly; cleanup rolled back.');
 const fk=store.all('PRAGMA foreign_key_check');if(fk.length)throw Error('Foreign-key validation failed; cleanup rolled back.');store.run('INSERT INTO expiration_cleanups VALUES(?,?,?,?,?)',id,now,'operator:requested-cleanup',saved,JSON.stringify(statistics));return{...statistics,originalProtectedTablesUnchanged:true,backup:saved,permanentlyDeleted:0,runId:id};});
 mkdirSync('reports/approved-expiration',{recursive:true});writeFileSync('reports/approved-expiration/cleanup-result.json',JSON.stringify(result,null,2));console.log(JSON.stringify(result,null,2));}finally{store.close();}
