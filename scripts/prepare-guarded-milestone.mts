/** Prepare private review metadata and a rollback-only preview. This script has no commit/publication operation. */
import assert from 'node:assert/strict';import {readFileSync,writeFileSync} from 'node:fs';import {PostgresDatabase,loadPostgresEnvironment} from '../server/postgres/connection';import {hash} from '../server/maintenance/policy';
loadPostgresEnvironment();const db=new PostgresDatabase(),report=JSON.parse(readFileSync('reports/maintenance/nc-live-source-pilot.json','utf8')),candidate=report.records.find((r:any)=>r.manualBatchCandidate);if(!candidate)throw Error('A verified private candidate is required');
try{const result=await db.transaction(async()=>{
 const baseline=(await db.one('SELECT public.buildwatch_audit_guard() v')).v;assert.deepEqual(baseline.gates,{writes:false,approved:false,schedule:false});
 const p=(await db.one('SELECT buildwatch.bw_project($1) p',[candidate.existingProject.id])).p;assert.equal(p.revision,candidate.existingProject.revision);assert.equal(candidate.evidence.fields.Action_Taken,'TRC Approved');
 const sourceId=JSON.parse(readFileSync('config/maintenance/nc-five-jurisdiction-plan.json','utf8')).find((s:any)=>s.name==='Apex').source.id;
 const context=(await db.one('SELECT buildwatch.bw_milestone_context($1) v',[p.id])).v,id=hash([p.id,p.revision,'Application Approval',candidate.eventDate.slice(0,10),candidate.sourceURL]);
 const data={id,kind:'milestone',projectId:p.id,projectName:p.name,jurisdiction:p.jurisdiction,reason:'Individually approve only this dated TRC infrastructure-application milestone. No overall status, location, source evidence or expiration-policy change.',before:{revision:p.revision,status:p.status},beforeProject:p,beforeContext:context,milestone:{type:'Application Approval',scope:'application_only',date:candidate.eventDate.slice(0,10),url:candidate.sourceURL},evidence:{sourceId,externalId:candidate.sourceRecordIdentifier,url:candidate.sourceURL,checkedAt:candidate.retrievedAt,eventDate:candidate.eventDate,attributes:{...candidate.evidence.fields,FID:candidate.stableIdentifiers.FID},summary:candidate.evidence.quote,responseHash:candidate.responseHash}};
 await db.query("INSERT INTO buildwatch.research_batches VALUES('guarded-application-review',now()::text,'{\"mode\":\"individual-admin-confirmation\",\"autoMerged\":0}') ON CONFLICT DO NOTHING");
 await db.query("INSERT INTO buildwatch.research_proposals(id,batch_id,kind,project_id,data,updated) VALUES($1,'guarded-application-review','milestone',$2,$3,buildwatch.bw_now()) ON CONFLICT DO NOTHING",[id,p.id,JSON.stringify(data)]);
 await db.query('SAVEPOINT preview_only');const preview=(await db.one('SELECT buildwatch.bw_research_preview($1,$2) p',[id,'preview-preparation-only'])).p;await db.query('ROLLBACK TO SAVEPOINT preview_only');await db.query('RELEASE SAVEPOINT preview_only');delete preview.token;
 const after=(await db.one('SELECT public.buildwatch_audit_guard() v')).v;assert.deepEqual(after,baseline);
 return{proposalId:id,preparedAt:new Date().toISOString(),applied:false,approvalRequired:true,baseline,preview};
 });writeFileSync('reports/maintenance/GUARDED-APPLICATION-MILESTONE.json',JSON.stringify(result,null,2));console.log(JSON.stringify({proposalId:result.proposalId,applied:false,beforeRevision:result.preview.before.revision,afterRevision:result.preview.after.revision,timelineBefore:result.preview.timelineBefore.length,timelineAfter:result.preview.timelineAfter.length,expectedNotifications:result.preview.expectedNotifications}));
}finally{await db.close();}
