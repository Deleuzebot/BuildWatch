import {readFileSync,writeFileSync} from 'node:fs';
const read=(name:string)=>JSON.parse(readFileSync('config/maintenance/'+name+'.json','utf8'));
const entries=read('nc-adapter-builds').entries,fixtures=read('nc-adapter-fixture-results').results;
const log=readFileSync('../../work/nc-adapter-github-results.json','utf8');const github=JSON.parse(log);
const rows=entries.map((e:any)=>{const fixture=fixtures.find((r:any)=>r.name===e.name&&r.type===e.type),pilot=github.find((r:any)=>r.name===e.name&&r.type===e.type);return{name:e.name,type:e.type,url:e.officialURL,build:e.status,fixture:fixture?.status||'not_applicable',documentPointers:fixture?.documentPointers||0,github:pilot?.status||'not_in_selected_sample',githubError:pilot?.error||'',followup:e.followupStatus,issues:e.errors};});
writeFileSync('config/maintenance/nc-adapter-validation-results.json',JSON.stringify({checkedAt:new Date().toISOString(),dryRun:true,githubRun:'https://github.com/Deleuzebot/BuildWatch/actions/runs/40902191918',rows},null,2)+'\n');
const table=rows.map((e:any)=>'| '+e.name+(e.type==='county'?' County':'')+' | '+e.build.replaceAll('_',' ')+' | '+e.fixture+' | '+e.github.replaceAll('_',' ')+' | [Official reference]('+e.url+') |');
writeFileSync('NC-ADAPTER-COVERAGE.md','# NC adapter readiness — October 29, 2026\n\nThis table covers the 57 previously pending areas and two agenda-index areas. An index adapter discovers document pointers; it is not verified project, location, status, or meeting coverage. All new candidates remain disabled and all public writes remain off.\n\nThe 16 usable indexes passed replay against the downloaded official snapshots with zero additional requests. The selected Linux pilot tested 24 sources; 13 retained access failures. Four successful retrievals contained only schedules/bylaws and were subsequently excluded from usable development indexes. General all-board indexes were also excluded.\n\n| Area | Build | Snapshot replay | Selected Linux pilot | Reference |\n| --- | --- | --- | --- | --- |\n'+table.join('\n')+'\n');
