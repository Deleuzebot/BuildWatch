/** One-time requested source check. No scheduler, project publication or database writes. */
import{DatabaseSync}from'node:sqlite';import{readFileSync,writeFileSync,mkdirSync}from'node:fs';
const db=new DatabaseSync('server/data/projects.json.sqlite',{readOnly:true}),projects=db.prepare("SELECT data FROM projects WHERE json_extract(data,'$.status')='Approved'").all().map((r:any)=>JSON.parse(r.data));
const items:any[]=[],checks:any[]=[],now=new Date().toISOString();
const date=(v:any)=>{if(!v)return;const n=typeof v==='number'?v:Date.parse(v);return Number.isFinite(n)?new Date(n).toISOString().slice(0,10):undefined;};
const groups=new Map<string,any[]>();for(const p of projects.filter((p:any)=>p.evidenceType==='municipal'))for(const s of p.sources||[]){try{const u=new URL(s.url);if(/\/(?:FeatureServer|MapServer)\/\d+\/query$/i.test(u.pathname)){const m=(u.searchParams.get('where')||'').match(/^(FID|OBJECTID)\s*=\s*(\d+)$/i);if(m){const root=u.origin+u.pathname.replace(/\/query$/,'');groups.set(root,[...(groups.get(root)||[]),{p,url:s.url,field:m[1],id:Number(m[2])}]);break;}}}catch{}}
for(const[root,refs]of groups){let read=0;try{const meta:any=await(await fetch(root+'?f=json',{signal:AbortSignal.timeout(20000)})).json();const oid=meta.objectIdField||meta.fields?.find((f:any)=>f.type==='esriFieldTypeOID')?.name;if(!oid)throw Error('No official identifier field');for(let offset=0;offset<refs.length;offset+=100){const chunk=refs.slice(offset,offset+100),u=new URL(root+'/query');u.search=new URLSearchParams({objectIds:chunk.map(r=>r.id).join(','),outFields:'*',returnGeometry:'false',f:'json'}).toString();const response=await fetch(u,{signal:AbortSignal.timeout(25000)});if(!response.ok)throw Error('HTTP '+response.status);const page:any=await response.json();if(page.error||page.exceededTransferLimit||!Array.isArray(page.features))throw Error(page.error?.message||'Incomplete source response');for(const r of chunk){const a=page.features.find((f:any)=>Number(f.attributes[oid])===r.id)?.attributes;if(!a){checks.push({projectId:r.p.id,status:'record-unavailable',url:r.url});continue;}read++;let field=['Approval_Date','ApprovalDate','APPRDATE'].find(k=>date(a[k]));if(!field&&a.Status==='Approved'&&date(a.Status_Date))field='Status_Date';if(!field&&/approved/i.test(a.Action_Taken||'')&&date(a.Action_Date))field='Action_Date';const schedules:any[]=[];for(const[k,v]of Object.entries(a)){if(/(?:est|planned|anticipated).*(?:construct|proj).*(?:start|comp)|(?:planned|anticipated).*completion/i.test(k)){const d=date(v);if(d&&Date.parse(d)>Date.now())schedules.push({date:d,kind:/start/i.test(k)?'start':'completion',url:r.url,quote:k+': '+String(v)});}}
items.push({projectId:r.p.id,approval:field?{date:date(a[field]),url:r.url,quote:`${field}: ${a[field]}; source status ${a.Status||a.RecordStatus||a.Action_Taken||r.p.sourceStatus}. This is the cited approval event, not an import/update timestamp.`}:null,schedules,checkedAt:now,reason:field?'Explicit approval field in official project record':'No unambiguous approval-date field in the cited record'});}
await new Promise(r=>setTimeout(r,700));}checks.push({jurisdiction:refs[0].p.jurisdiction,status:'checked',records:read,url:root});}catch(e){checks.push({jurisdiction:refs[0].p.jurisdiction,status:'error',error:String(e),url:root});}}
// Existing Cary records use full application identifiers, never numeric suffix matching.
const cary=projects.filter((p:any)=>p.jurisdiction==='Cary');for(let offset=0;offset<cary.length;offset+=25){const chunk=cary.slice(offset,offset+25),refs=chunk.map((p:any)=>{const source=p.sources.find((s:any)=>s.url.includes('datasets/developments/records'));const where=new URL(source.url).searchParams.get('where')||'';return{p,source,id:where.match(/applicationnumber='([^']+)'/)?.[1]};}).filter((r:any)=>r.id);try{const u=new URL('https://data.townofcary.org/api/explore/v2.1/catalog/datasets/developments/records');u.search=new URLSearchParams({where:'applicationnumber in ('+refs.map((r:any)=>'"'+r.id+'"').join(',')+')',limit:'100',select:'applicationnumber,status,actiondate,applicationname,summarydescription'}).toString();const response=await fetch(u,{signal:AbortSignal.timeout(25000)});if(!response.ok)throw Error('HTTP '+response.status);const page:any=await response.json();if(!Array.isArray(page.results)||page.total_count>100)throw Error('Incomplete Cary response');for(const r of refs){const matches=page.results.filter((a:any)=>a.applicationnumber===r.id);const approved=matches.filter((a:any)=>a.status==='Approved'&&date(a.actiondate));const distinct=[...new Set(approved.map((a:any)=>date(a.actiondate)))];items.push({projectId:r.p.id,approval:distinct.length===1?{date:distinct[0],url:r.source.url,quote:`Application ${r.id}, status Approved, official actiondate ${distinct[0]}.`}:null,schedules:[],checkedAt:now,reason:distinct.length===1?'Explicit approved application action':'Active is not an approval date; missing/conflicting dates require review'});}checks.push({jurisdiction:'Cary',status:'checked',records:refs.length});}catch(e){checks.push({jurisdiction:'Cary',status:'error',error:String(e)});}await new Promise(r=>setTimeout(r,700));}
// Construction timelines manually verified in the current official pages. Preserve their stated precision.
items.push({projectId:'nc-ra-smoky-hollow-park',approval:{date:'2024-05-07',url:'https://raleighnc.gov/projects/smoky-hollow-park-project',quote:'Schematic Design adopted by City Council on May 7, 2024.'},schedules:[{date:'2029',kind:'completion',url:'https://raleighnc.gov/projects/smoky-hollow-park-project',published:'2026-09-25',quote:'Updated City schedule: construction starts in 2027; project completion and park opening in 2029.'}],checkedAt:now});
items.push({projectId:'nc-ch-longleaf-trace',approval:{date:'2024-04-17',url:'https://chapelhill.legistar.com/LegislationDetail.aspx?GUID=F2B4E4E2-AC78-4D21-896C-0FAD00C00218&ID=6615102',quote:'Council enacted the Longleaf Trace conditional zoning on April 17, 2024.'},schedules:[{date:'2027',kind:'completion',url:'https://www.chapelhillnc.gov/Town-Services/Housing/Affordable-Housing/Affordable-Housing-Funding',quote:'Affordable housing project funding table: Longleaf Trace, Preconstruction, Completion Year 2027.'}],reason:'Approval confirmed in Council legislation; future completion year confirmed by the Town housing funding table.',checkedAt:now});
items.push({projectId:'nc-ch-tanyard-branch-trace',approval:{date:'2022-04-27',url:'https://www.chapelhillnc.gov/Projects/Jay-Street-Affordable-Housing',quote:'Council approved the conditional zoning application on April 27, 2022.'},schedules:[{date:'2026',kind:'start',url:'https://www.chapelhillaffordablehousing.org/jay-street-affordable-housing-development',quote:'Town project status says plans, permits and financing are being finalized before construction starts in 2026. The year is a documented range, not an invented exact date.'}],checkedAt:now});
items.push({projectId:'nc-ch-200-elliott',approval:{date:'2025-06-25',url:'https://chapelhill.legistar.com/LegislationDetail.aspx?FullText=1&GUID=8DCF965B-AC41-4967-8316-2DCF623B4BDF&ID=7444607',quote:'Council final enacted conditional-zoning action June 25, 2025; original approval April 9, 2025. Both approval actions are over 365 days old.'},schedules:[],checkedAt:now});
mkdirSync('reports/approved-expiration',{recursive:true});writeFileSync('reports/approved-expiration/evidence.json',JSON.stringify({checkedAt:now,items,checks,limitations:['Stormwater effective dates are not treated as original development approval dates. Permit-only records are separately archived as supporting-only, with original data retained.','No construction exception is inferred from vague future language or bare completion text without an identifiable supporting source.','Source-specific record fields and the checked existing documentation establish this cleanup, not an exhaustive search of all possible project documents. Additional documentation can be entered by administrators before restoration.']},null,2));db.close();console.log(JSON.stringify({items:items.length,documentedApprovals:items.filter(i=>i.approval).length,checks},null,2));
