/** Manual Linux document check only. No database client, credentials, publication or scheduling. */
import assert from 'node:assert/strict';import {readFileSync,writeFileSync,mkdirSync} from 'node:fs';import {createHash} from 'node:crypto';
import {Budget} from '../server/maintenance/policy';import {SourceHTTP} from '../server/maintenance/http';import {robotsAllows,robotsUnavailableAllows} from '../server/maintenance/worker';import {extractAgendaPDF,agendaReferences} from '../server/maintenance/agendas';
const plan=JSON.parse(readFileSync('config/maintenance/nc-pdf-validation-plan.json','utf8'));assert.equal(plan.publication,false);assert.equal(plan.maximumGovernmentHTTPRequests,8);assert.equal(plan.sources.length,4);assert.equal(process.env.GITHUB_EVENT_NAME,'workflow_dispatch');
const output='reports/nc-pdf-validation';mkdirSync(output,{recursive:true});const budget=new Budget(300,8,1000,60_000_000),requests:any[]=[],documents:any[]=[];
const transport:typeof fetch=async(input,init)=>{assert.ok(requests.length<8);const entry:any={url:String(input),startedAt:new Date().toISOString()};requests.push(entry);try{const response=await fetch(input,init);entry.status=response.status;entry.completedAt=new Date().toISOString();return response;}catch(e:any){entry.error=e.message;throw e;}};
for(const source of plan.sources){try{const url=new URL(source.url);assert.ok(['www.burkenc.org','caldwellcountync.org','carteretcountync.gov','www.catawbacountync.gov'].includes(url.hostname));const http=new SourceHTTP(budget,url.origin,transport);let policy='';try{policy=(await http.get(url.origin+'/robots.txt')).body;}catch(e:any){if(!robotsUnavailableAllows({adapter:'document',authority:'official',url:source.url} as any,e.message))throw e;}
 http.accessPolicy=target=>robotsAllows(policy,target.pathname+target.search);const data=await http.getPDF(source.url,'planning50'),pdf=await extractAgendaPDF(data.rawBody,'planning50'),sha256=createHash('sha256').update(data.rawBody).digest('hex');
 documents.push({...source,status:pdf.truncated?'truncated':'extracted',bytes:data.rawBody.length,sha256,...pdf,references:agendaReferences(pdf,source.url),requiresReview:true,decisionConfirmed:false});
}catch(e:any){documents.push({...source,status:'unresolved',error:e.message});}}
const result={createdAt:new Date().toISOString(),governmentRequests:requests.length,downloadBytes:budget.bytes,maximumRequests:8,requests,documents,publication:false,databaseWrites:0,paidServices:false,profile:'planning50',status:documents.every(d=>d.status==='extracted')?'completed':'partially_completed'};
writeFileSync(output+'/result.json',JSON.stringify(result,null,2));console.log(JSON.stringify({...result,documents:documents.map(({pages,references,...d})=>({...d,referenceCount:references?.length||0}))}));
