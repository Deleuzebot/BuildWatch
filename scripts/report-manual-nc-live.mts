/** Build a private review artifact from captured evidence. No network or publication. */
import assert from 'node:assert/strict';
import {readFileSync,writeFileSync} from 'node:fs';
import {hash} from '../server/maintenance/policy';
const dir=process.argv[2];if(!dir)throw Error('Supply the completed private capture directory');
const read=(name:string)=>JSON.parse(readFileSync(dir+'/'+name+'.json','utf8'));
const receipt=read('receipt'),reconciliation=read('reconciliation'),ledger=read('ledger');
assert.equal(receipt.productionUnchanged,true);assert.equal(receipt.stats.requests,ledger.requests.length);
assert.ok(receipt.stats.requests<=50&&receipt.stats.searchQueries<=4);
assert.equal(ledger.closed,true,'Close the capture before producing a final report');
const content=(name:string)=>read(name).body as string;
const text=(name:string)=>content(name).replace(/<script\b[\s\S]*?<\/script>/gi,' ').replace(/<style\b[\s\S]*?<\/style>/gi,' ').replace(/<[^>]+>/g,' ').replace(/\s+/g,' ');
const citation=(name:string,quote:string)=>{const r=read(name);assert.ok(text(name).includes(quote),'Captured evidence no longer supports '+name);return{url:r.url,retrievedAt:r.retrievedAt,sha256:hash(r.body),quote};};
const proposals:any[]=[];
for(const record of reconciliation.records.filter((r:any)=>r.proposed.milestone)){
 assert.equal(record.identity.matched,true);assert.equal(record.footprintContainsExistingPin,true);
 proposals.push({project:record.name,projectId:record.before.id,revision:record.before.revision,kind:'historical_application_milestone_backfill',confidence:'high identity and official application-action evidence; historical backfill, not a newly occurring approval',before:{...record.before,timelineAppend:null},after:{...record.before,revision:record.before.revision+1,timelineAppend:record.proposed.milestone},source:{url:record.sourceURL,recordId:record.externalId,eventDate:record.sourceDates.applicationActionAt,verifiedAt:record.verifiedAt,applicationAction:record.sourceFacts.applicationAction},conditions:['Administrator confirms the concrete proposal against a fresh revision-bound preview','Preserve existing events, status, coordinates, description and approval policy','Recheck full history and pending proposals before writing'],applied:false});
}
const project=reconciliation.candidateProjects.find((p:any)=>p.id==='nc-ch-611-mlk');
assert.ok(project&&!project.archived&&project.name==='611 MLK Multifamily'&&project.city==='Chapel Hill');
const page=citation('chapel-611-project','Formal Application Under Review'),event=citation('chapel-611-meeting','05:15 PM - 06:15 PM');
assert.ok(text('chapel-611-project').includes('Virtual'));
assert.ok(text('chapel-611-meeting').includes('November 02, 2026'));
assert.ok(text('chapel-611-project').includes('CZD-26-6'));
assert.ok(Math.abs(project.latitude-35.9192368)<0.000001&&Math.abs(project.longitude-(-79.0566993))<0.000001);
const meeting={id:'nc-ch-611-mlk-public-information-2026-11-02',title:'611 MLK Multifamily — Public Information Meeting',startsAt:'2026-11-02T22:15:00.000Z',venue:'Virtual — use the Town meeting page for registration',agenda:event.url};
const already=(project.meetings||[]).some((m:any)=>m.id===meeting.id||m.startsAt===meeting.startsAt);
if(!already)proposals.push({project:project.name,projectId:project.id,revision:project.revision,kind:'public_meeting_addition',confidence:'high: official project page and official event page agree on identity/date/time/virtual venue',matchingMethod:'exact official project URL, name, CZD-26-6 identity, address and unchanged official coordinates',before:{revision:project.revision,meetings:project.meetings||[],status:project.status,description:project.description,latitude:project.latitude,longitude:project.longitude},after:{revision:project.revision+1,meetings:[...(project.meetings||[]),meeting],status:project.status,description:project.description,latitude:project.latitude,longitude:project.longitude},eventDetails:{localDate:'2026-11-02',localTime:'17:15–18:15',timeZone:'America/New_York',endsAt:'2026-11-02T23:15:00.000Z',note:'Existing Meeting model stores start time only. Registration link is a Town-published Teams link; attendee access not tested. No approval or construction inference.'},sources:[page,event],approvalPolicyChange:null,conditions:['Fresh administrator preview and meeting deduplication before any write','Notification effects must be previewed before authorization; no notifications were created during research'],applied:false});
const fordham=citation('fordham-sidepath','Last week the contractor worked on installing construction entrances at Cleland Dr., S. Estes Dr., Ridgefield Rd., and Willow Dr.');
assert.ok(text('fordham-sidepath').includes('Weekly Update 10/26/26'));
const withheld=[{project:'Fordham Boulevard Sidepath',evidence:fordham,publicationDate:'2026-10-26',eventDate:null,interpretation:'Actual construction progress reported for the previous week; do not assign an exact construction-start date.',potentialChange:'Under-construction evidence, progress milestone and factual description candidate',reason:'No unique canonical Chapel Hill corridor identity matched in bounded Supabase lookup. Charlotte Fordham Park is unrelated. Establish parent/corridor/phase and official geometry before proposing a new marker or updating an existing one.'},{project:'Wilson Ball Park / hotel redevelopment',sources:[citation('wilson-stadium-official','04/16/2026 9:00 AM'),{url:read('wilson-stadium-builder').url,sha256:hash(content('wilson-stadium-builder'))}],interpretation:'Official April opening and contractor completion evidence concern the stadium. The GIS record also includes a future hotel phase.',reason:'Do not archive the composite development or republish archived stormwater permits. Parent/hotel phase identity and current status remain unresolved.'},{project:'NC Childrens Health Infrastructure',proposalId:'e33172acb9b0d5fce1cba9376b70da7f27dc2c06d8a718704c72af66261c88a1',reason:'Existing pending October 22 TRC milestone proposal found; suppress duplicate proposal. Preserve overall Proposed status, pin and approval policy.'},{project:'Raleigh Salvage Yards / Indivior supporting permits',reason:'Two substantial application components require verified parent-project bindings and fuller planning evidence. Permit issuance alone does not prove construction. Four other sampled permits are minor/amenity work and excluded.'},{project:'Lincoln and Forsyth samples',reason:'Lincoln rezoning and variance cases lack verified parent-development bindings; corrected narrative/document-URL mapping. Forsyth newest sampled decisions have year 2020 only: historical evidence, not current coverage. Repeated docket identifiers require multipart/case grouping; the private journal safely rejected that sample instead of overwriting identities.'},{project:'Chapel Hill completed / withdrawn / denied application labels',reason:'Missing dated whole-project decision evidence or combined application scope; no cancellation, completion or archival proposal.'},{project:'Fire Station #4',reason:'Still private. No verified identity established by this pilot.'}];
const report={runId:receipt.runId,createdAt:new Date().toISOString(),publication:false,archival:false,scheduling:false,paidServices:false,productionWrites:0,productionUnchanged:reconciliation.productionUnchanged,usage:receipt.stats,remaining:{http:50-receipt.stats.requests,searches:4-receipt.stats.searchQueries,note:'Unused capacity belongs only to this one pilot; no recurring budget raised.'},summary:{...reconciliation.summary,reviewableProposalCount:proposals.length,newPublicProjectAdditionsProposed:0,statusChangesProposed:0,archivesProposed:0,descriptionUpdatesProposed:0,meetingAdditionsProposed:already?0:1,historicalMilestoneBackfillsProposed:proposals.filter(p=>p.kind==='historical_application_milestone_backfill').length},proposals,withheld,limitations:['131 rows are bounded latest-record samples, not statewide coverage or full pagination.','A matched existing record is not necessarily unchanged; only explicitly compared fields were evaluated. No broad unchanged count claimed.','Secondary source corroboration succeeded for the Wilson stadium component; it did not establish the hotel phase or produce a publishable new development.','Factual descriptions were evaluated but none met the identity, scope and chronology requirements for a concrete replacement.','Source-page HTTP is exactly ledgered; search-provider internal requests are opaque and four search queries are accounted separately.','No government PDF was downloaded in this pilot; existing PDF extraction was not rebenchmarked.','No publication or notification delivery was executed or tested.'],receipt:dir+'/receipt.json',recordEvidence:dir+'/reconciliation.json'};
writeFileSync(dir+'/proposals.json',JSON.stringify(report,null,2));
const table=proposals.map(p=>`| ${p.project} | ${p.kind==='public_meeting_addition'?'Add November 2 virtual meeting, 5:15–6:15 p.m. Eastern':'Append historical scoped TRC approval milestone '+p.source.eventDate.slice(0,10)} | Preserve |`).join('\n');
writeFileSync(dir+'/REPORT.md',`# North Carolina live research pilot\n\nPublication, archival, schedules and paid services remain off. No production project writes.\n\nUsed **${receipt.stats.requests}/50 HTTP requests and ${receipt.stats.searchQueries}/4 searches**; ${50-receipt.stats.requests} HTTP requests unused. Source downloads, robots checks, redirects and retries count; search-provider internal HTTP is not observable. Downloaded ${(receipt.stats.downloadBytes/1e6).toFixed(2)} MB.\n\nExamined 131 government rows across Apex, Cary, Chapel Hill, Wilson, Lincoln, Forsyth and Raleigh. Verified 35 canonical matches; 96 samples remain unmatched or conflicted. These are samples, not complete coverage.\n\n| Project | Proposed change | Status/location/approval policy |\n| --- | --- | --- |\n${table}\n\nApex NC Children's Health Infrastructure already has a pending October 22 scoped TRC approval proposal: no second copy created. Altera Heights and Glenn Square are historical timeline backfills, not recent approvals or construction transitions.\n\nNo new public projects, status changes, archives or replacement descriptions are recommended by this bounded pilot. Four minor/amenity Raleigh permits are excluded.\n\nFordham Sidepath has official October 26 construction-progress evidence, but canonical corridor identity and geometry remain unresolved. Wilson stadium is open, while the combined hotel phase is unverified; no composite completion inferred. Lincoln application cases need parent bindings. Forsyth's newest samples are 2020 year-only decisions. Fire Station #4 stays private.\n\nExact before/after fields, citations, retrieval times, conditions and withheld findings: [proposals.json](./proposals.json). All 131 record-level comparisons: [reconciliation.json](./reconciliation.json).\n\nProduction hash checks passed. No changes were applied. A fresh administrator preview and explicit authorization of the concrete changes remain required before publication.\n`);
console.log(JSON.stringify({proposals:proposals.length,summary:report.summary,report:dir+'/REPORT.md'}));
