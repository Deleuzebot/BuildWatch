/** No government network requests. Large profile is benchmark-only here. */
import {writeFileSync,mkdirSync,appendFileSync} from 'node:fs';import {extractAgendaPDF} from '../server/maintenance/agendas';import {syntheticPDF} from '../server/maintenance/pdf-fixture';import {pdfLimits} from '../server/maintenance/pdf-limits';
if(process.platform!=='linux')throw Error('Benchmark requires the Linux resource sandbox');process.env.BW_PDF_50MB_BENCHMARK='true';
const rows:any[]=[];
for(const test of[{name:'50 MB transport boundary',pages:1,bytes:50_000_000,expect:'parsed'},{name:'200 text pages',pages:200,bytes:0,expect:'parsed'},{name:'201 pages',pages:201,bytes:0,expect:'truncated'},{name:'over 50 MB',pages:1,bytes:50_000_001,expect:'rejected'},{name:'over expanded-stream limit',pages:1,bytes:0,expanded:8_100_000,expect:'rejected'},{name:'malformed PDF',pages:0,bytes:0,expect:'rejected'}]){
 const started=performance.now();try{const data=test.pages?syntheticPDF(test.pages,test.bytes,test.expanded):Buffer.from('%PDF-1.4\nmalformed');const pdf=await extractAgendaPDF(data,'planning50');const outcome=pdf.truncated?'truncated':'parsed';rows.push({name:test.name,expected:test.expect,outcome,passed:outcome===test.expect,bytes:data.length,pages:pdf.pages.length,totalPages:pdf.totalPages,metrics:pdf.metrics,parentRSSBytes:process.memoryUsage().rss,wallMs:Math.round(performance.now()-started)});}catch(e:any){rows.push({name:test.name,expected:test.expect,outcome:'rejected',passed:test.expect==='rejected',reason:e.message,wallMs:Math.round(performance.now()-started)});}console.log(JSON.stringify(rows.at(-1)));
}
const result={synthetic:true,governmentRequests:0,limits:pdfLimits.planning50,passed:rows.every(r=>r.passed),rows};mkdirSync('reports/maintenance',{recursive:true});writeFileSync('reports/maintenance/pdf-50mb-benchmark.json',JSON.stringify(result,null,2));if(process.env.GITHUB_STEP_SUMMARY)appendFileSync(process.env.GITHUB_STEP_SUMMARY,'## PDF 50 MB / 200-page benchmark\n\n'+rows.map(r=>'- '+r.name+': '+r.outcome+'; passed='+r.passed+'; '+r.wallMs+' ms').join('\n')+'\n\nSynthetic boundary tests only. Production default remains 2 MB.\n');if(!result.passed)process.exitCode=1;
