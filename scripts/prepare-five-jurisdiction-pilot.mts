/** Small source-schema scout and immutable database safety baseline. */
import {mkdirSync,writeFileSync,readFileSync,readdirSync} from 'node:fs';import {loadPostgresEnvironment,PostgresDatabase} from '../server/postgres/connection';import {ResearchReader} from '../server/maintenance/research-reader';import {Budget,hash} from '../server/maintenance/policy';
loadPostgresEnvironment();const db=new PostgresDatabase(),budget=new Budget(300,20,100);budget.maxBytes=20_000_000;mkdirSync('../../work/nc-e2e',{recursive:true});
const selected=[['Cary','source-682be2f330dca1be45edbd5dcf27a7'],['Apex','source-8ad50df7b7918cceaf0e16245fd827'],['Huntersville','source-cced580bef87ae08ecb3cfeeb97ed6'],['Burlington','source-1bb48732857df49b9ee9972bcf0739'],['Kannapolis','source-8c1eabeb036a4393e890729df7c630']];
const reader=new ResearchReader(budget,(url,r)=>writeFileSync('../../work/nc-e2e/'+hash(url)+'.json',JSON.stringify({url,body:r.body,hash:hash(r.body),checkedAt:new Date().toISOString()})));
try{
 const control=await db.one('SELECT * FROM buildwatch.maintenance_control WHERE id=1');if(control.schedule_enabled||control.writes_enabled)throw Error('Keep publication off');
 const reserved=await db.query("UPDATE buildwatch.maintenance_monthly SET requests_reserved=requests_reserved+20 WHERE month=date_trunc('month',now())::date AND requests_reserved+20<=(SELECT monthly_requests FROM buildwatch.maintenance_control WHERE id=1) RETURNING month");if(!reserved.rowCount)throw Error('Existing approved budget is exhausted');
 const sources=await db.rows('SELECT id,state,jurisdiction,url,adapter,authority,enabled,autopublish,config FROM buildwatch.maintenance_sources WHERE id=ANY($1::text[])',[selected.map(s=>s[1])]);
 writeFileSync('config/maintenance/nc-five-jurisdiction-plan.json',JSON.stringify(selected.map(([name,id])=>({name,source:sources.find(s=>s.id===id)})),null,2)+'\n');
 const baseline=await db.one("SELECT (SELECT count(*) FROM buildwatch.projects) projects,(SELECT md5(string_agg(id||md5(data::text),',' ORDER BY id)) FROM buildwatch.projects) projects_hash,(SELECT md5(string_agg(project_id||md5(to_jsonb(a)::text),',' ORDER BY project_id)) FROM buildwatch.approval_policy a) approval_hash,(SELECT count(*) FROM buildwatch.history) history,(SELECT count(*) FROM buildwatch.maintenance_mutations) mutations");writeFileSync('../../work/nc-e2e/baseline.json',JSON.stringify(baseline,null,2));
 const scout:any[]=[];for(const source of sources.filter(s=>s.adapter==='arcgis')){
  try{const meta=JSON.parse((await reader.get(source.url+'?f=json')).body);const u=new URL(source.url+'/query');u.search=new URLSearchParams({f:'json',where:'1=1',outFields:'*',returnGeometry:'false',resultRecordCount:'8',orderByFields:source.config.orderByFields||source.config.idField}).toString();const data=JSON.parse((await reader.get(u.href)).body);scout.push({name:source.jurisdiction,id:source.id,fields:meta.fields,rows:(data.features||[]).map((f:any)=>f.attributes)});}catch(e:any){scout.push({name:source.jurisdiction,error:e.message});}
 }writeFileSync('../../work/nc-e2e/scout.json',JSON.stringify(scout,null,2));console.log(JSON.stringify({jurisdictions:selected.length,requests:budget.requests,scout:scout.map(s=>({name:s.name,records:s.rows?.length,error:s.error})),baseline}));
}finally{await db.close();}
