/** Cached official evidence + current read-only reconciliation; existing preview runs inside ROLLBACK. No publisher or government HTTP. */
import assert from 'node:assert/strict';import {readFileSync,writeFileSync,mkdirSync} from 'node:fs';import {resolve} from 'node:path';
import {PostgresDatabase,loadPostgresEnvironment} from '../server/postgres/connection';import {hash} from '../server/maintenance/policy';
const input=resolve('../../work/buildwatch-live/manual-nc-live-statewide-20261030'),out=resolve('../../work/buildwatch-nc-useful-update-review');mkdirSync(out,{recursive:true,mode:0o700});
const read=(name:string)=>JSON.parse(readFileSync(input+'/'+name+'.json','utf8')),report=read('reconciled-report'),ledger=read('ledger'),sources=read('sources');
assert.equal(ledger.closed,true);assert.equal(ledger.requests.length,500);const candidates=report.findings.filter((v:any)=>v.proposals.length);assert.equal(candidates.length,80);
const apex=sources.find((s:any)=>s.jurisdiction==='Apex'),official=new Map<string,any[]>();
for(const [url,entry] of Object.entries(ledger.responses) as any){if(!url.startsWith(apex.url+'/query?'))continue;const cached=JSON.parse(readFileSync(input+'/'+entry.file,'utf8'));assert.equal(hash(cached.body),entry.sha256);assert.equal(cached.sha256,entry.sha256);
 for(const feature of JSON.parse(cached.body).features||[]){const a=feature.attributes;if(!a?.FID)continue;const key=String(a.FID);official.set(key,[...(official.get(key)||[]),{attributes:a,url,retrievedAt:cached.retrievedAt,sha256:entry.sha256}]);}}
loadPostgresEnvironment();const db=new PostgresDatabase();let baseline:any,reviewed:any[]=[],pending:any[]=[];
try{
 await db.transaction(async()=>{
  baseline=(await db.one('SELECT public.buildwatch_audit_guard() v')).v;assert.deepEqual(baseline.gates,{writes:false,approved:false,schedule:false});
  const ids=candidates.map((c:any)=>c.projectId),rows=await db.rows('SELECT id,buildwatch.bw_project(id) project,buildwatch.bw_milestone_context(id) context FROM buildwatch.projects WHERE id=ANY($1::text[])',[ids]);
  const refs=await db.rows('SELECT external_id,buildwatch.bw_canonical(project_id) project_id FROM buildwatch.maintenance_refs WHERE source_id=$1 AND external_id=ANY($2::text[])',[apex.id,candidates.map((c:any)=>c.sourceRecordId)]);
  pending=await db.rows("SELECT id,project_id,status,data FROM buildwatch.research_proposals WHERE project_id=ANY($1::text[]) AND kind='milestone' AND status IN('pending','deferred')",[ids]);
  for(const candidate of candidates){const row=rows.find(r=>r.id===candidate.projectId);assert.ok(row);const p=row.project,context=row.context,m=candidate.proposals[0].after.appendMilestone,records=official.get(candidate.sourceRecordId)||[];
   const evidence=records.find((r:any)=>r.attributes.Name===p.name&&r.attributes.Action_Taken==='TRC Approved'&&Number.isFinite(r.attributes.Action_Date)&&new Date(r.attributes.Action_Date).toISOString().slice(0,10)===m.date);
   const canonical=[...new Set(refs.filter(r=>r.external_id===candidate.sourceRecordId).map(r=>r.project_id))],duplicate=context.activities.some((a:any)=>a.event_key===m.key||a.event_date===m.date&&/approval/i.test(a.type));
   const checks={exactCanonicalIdentity:canonical.length===1&&canonical[0]===p.id,exactOfficialName:!!evidence,officialSourceHashVerified:!!evidence,decisionIsTRCApplicationOnly:evidence?.attributes.Action_Taken==='TRC Approved',dateVerified:!!evidence&&new Date(evidence.attributes.Action_Date).toISOString().slice(0,10)===m.date&&Date.parse(m.date)<=Date.now(),notDuplicate:!duplicate,projectActive:!p.archived&&!['Completed','Cancelled'].includes(p.status)};
   const accepted=Object.values(checks).every(Boolean),recent=m.date>='2026-10-01';
   reviewed.push({projectId:p.id,name:p.name,sourceRecordId:candidate.sourceRecordId,date:m.date,recent,checks,confidence:accepted?'all_milestone_evidence_gates_passed':'withheld',decision:!accepted?'withhold':recent?'propose_for_individual_confirmation':'defer_historical_backfill',before:p,context,milestone:m,evidence:evidence||null,publicSourceURL:candidate.sourceURL,uncertainty:['TRC approval is for the infrastructure/application component, not proof of whole-development approval or construction.','Evidence is a verified cached government response; no fresh government HTTP was authorized in this review.']});
  }
 },true);
 const selected=reviewed.filter(v=>v.decision==='propose_for_individual_confirmation').sort((a,b)=>b.date.localeCompare(a.date)).slice(0,10);assert.equal(selected.length,1,'Do not pad a recent batch with historical backfills');
 const previews:any[]=[];
 for(const item of selected){const old=pending.filter(p=>p.project_id===item.projectId).filter(p=>{const data=JSON.parse(p.data);return data.milestone?.date===item.date;});assert.equal(old.length,1,'Reuse an existing equivalent private proposal rather than duplicating it');
  const c=await db.pool.connect();try{await c.query('BEGIN');await c.query("SET LOCAL statement_timeout='30s'");const p=(await c.query('SELECT buildwatch.bw_research_preview($1,$2) value',[old[0].id,'private-review-only-not-a-production-approval'])).rows[0].value;delete p.token;
   assert.deepEqual(p.before,item.before);assert.deepEqual(p.after,{...p.before,revision:p.before.revision+1});assert.deepEqual(p.policyBefore,p.policyAfter);assert.equal(p.expectedNotifications,0);assert.equal(p.historyAfter,p.historyBefore+1);assert.equal(p.timelineAfter.length,p.timelineBefore.length+1);assert.ok(p.timelineBefore.every((a:any)=>p.timelineAfter.some((b:any)=>JSON.stringify(a)===JSON.stringify(b))));
   previews.push({proposalId:old[0].id,preview:p,evidence:item.evidence,checks:item.checks,approvalRequired:true,applied:false,previewTokenRolledBack:true});
  }finally{await c.query('ROLLBACK');c.release();}
 }
 assert.deepEqual((await db.one('SELECT public.buildwatch_audit_guard() v')).v,baseline);
 // Reconstruct old request attribution without claiming that historical robots costs were explicitly tagged.
 const direct=(url:string)=>{const u=new URL(url);return sources.filter((s:any)=>{const b=new URL(s.url);return u.origin===b.origin&&(u.pathname===b.pathname||u.pathname.startsWith(b.pathname.replace(/\/$/,'')+'/'));}).sort((a:any,b:any)=>b.url.length-a.url.length)[0];};
 const assigned=ledger.requests.map((r:any,index:number)=>{let source=direct(r.url),method=source?'exact_registered_endpoint':'supporting_research';
  if(!source&&new URL(r.url).pathname==='/robots.txt'){const origin=new URL(r.url).origin,next=ledger.requests.slice(index+1).find((n:any)=>new URL(n.url).origin===origin&&direct(n.url));source=next?direct(next.url):null;if(source)method='shared_origin_robots_association';}
  return{ordinal:r.ordinal,url:r.url,status:r.status||null,error:r.error||null,sourceId:source?.id||'support:'+new URL(r.url).hostname,sourceName:source?.jurisdiction||'Supporting research — '+new URL(r.url).hostname,method};});
 const sourceStats=[...new Set([...sources.map((s:any)=>s.id),...assigned.map((r:any)=>r.sourceId)])].map(id=>{const s=sources.find((s:any)=>s.id===id),requests=assigned.filter((r:any)=>r.sourceId===id),findings=report.findings.filter((f:any)=>f.sourceId===id),milestones=reviewed.filter(r=>id===apex.id),recent=milestones.filter(r=>r.recent&&r.confidence==='all_milestone_evidence_gates_passed').length;
  return{sourceId:id,jurisdiction:s?.jurisdiction||requests[0]?.sourceName,url:s?.url||null,requests:requests.length,sharedRobotsRequests:requests.filter((r:any)=>r.method==='shared_origin_robots_association').length,requestErrors:requests.filter((r:any)=>r.error||r.status>=400).length,observations:findings.length,canonicalMatches:findings.filter((r:any)=>r.projectId).length,recentVerifiedMilestones:recent,historicalMilestones:milestones.filter(r=>!r.recent).length,verifiedAdditions:0,verifiedStatusChanges:0,verifiedDescriptionChanges:0};}).sort((a,b)=>b.requests-a.requests);
 assert.equal(sourceStats.reduce((n,s)=>n+s.requests,0),500);
 const result={createdAt:new Date().toISOString(),productionWrites:0,governmentHTTPRequests:0,searches:0,automaticPublication:false,archival:false,scheduling:false,baseline,ci:{id:41100519772,commit:'eed82376f765befa26534f7a1242845f89d4abfa',conclusion:'success'},summary:{reviewed:reviewed.length,recent:reviewed.filter(r=>r.recent).length,historical:reviewed.filter(r=>!r.recent).length,allEvidenceGatesPassed:reviewed.filter(r=>r.confidence==='all_milestone_evidence_gates_passed').length,withheld:reviewed.filter(r=>r.confidence!=='all_milestone_evidence_gates_passed').length,selected:previews.length,historicalSelected:0},previews,reviewed,sourceStats,requestAttribution:assigned,limitations:['Historical ledger did not tag source IDs; endpoint paths provide direct attribution, while shared-origin robots checks are explicitly associated/inferred. All 500 requests reconcile exactly.','A metadata request or index retrieval is not a completed project verification. Errors include robots responses that existing official-ArcGIS policy permits treating as unavailable.','The pending administrator proposal is reused. Preview tokens were rolled back; approval and fresh administrator MFA preview are still required to publish.','A lack of verified new changes shortly after a data refresh is not evidence that a source is useless.']};
 writeFileSync(out+'/REVIEW.json',JSON.stringify(result,null,2),{mode:0o600});
 const item=previews[0],p=item.preview;
 writeFileSync(out+'/APPROVAL.md',`# Proposed production batch — one milestone only\n\nNo production writes. No government HTTP or searches. Approval is required.\n\nProject: **${p.before.name}**, ID ${p.before.id}. Existing private proposal ${item.proposalId} is reused.\n\n| Field | Before | Proposed after |\n|---|---|---|\n| Timeline | ${p.timelineBefore.length} existing milestones | Preserve all; append Application Approval, **${p.milestone.date}** |\n| Scope | Existing development | TRC approval of this infrastructure application only |\n| Status | ${p.before.status} | ${p.after.status} (unchanged) |\n| Description | Existing text | Identical |\n| Coordinates | ${p.before.latitude}, ${p.before.longitude} | Identical |\n| Approval / expiration policy | ${JSON.stringify(p.policyBefore)} | Identical |\n| Revision | ${p.before.revision} | ${p.after.revision} |\n| History snapshots | ${p.historyBefore} | ${p.historyAfter} |\n| Notification rows | Existing | 0 new |\n\nEvent text: ${p.milestone.description}\n\n[Official government record](${p.milestone.url}). FID ${item.evidence.attributes.FID}; Action_Taken = TRC Approved; Action_Date = ${item.evidence.attributes.Action_Date}. Cached response verified by SHA-256 ${item.evidence.sha256}, retrieved ${item.evidence.retrievedAt}.\n\nThis does not approve the broader hospital or indicate construction. No source references, classifications, descriptions, locations or expiration dates change. Exact complete before/after snapshots and all 80 candidate checks are in REVIEW.json.\n\nThe other **79 historical backfills remain deferred**; the newest is February 26, 2026. They do not fill this batch merely to reach ten. Before publishing, obtain approval of this one proposal and generate a fresh revision-bound administrator/MFA preview. No post-publication one-click undo is claimed for research milestones; a correction would require a separately authorized audited compensation.\n`,{mode:0o600});
 const table=sourceStats.map(s=>`| ${s.jurisdiction} | ${s.requests} | ${s.sharedRobotsRequests} | ${s.canonicalMatches} | ${s.recentVerifiedMilestones} | ${s.historicalMilestones} |`).join('\n');
 writeFileSync(out+'/EFFICIENCY.md',`# NC research efficiency and candidate review\n\n${JSON.stringify(result.summary)}. No live government requests or production writes in this review. [Final prior CI passed](https://github.com/Deleuzebot/BuildWatch/actions/runs/41100519772) at eed82376f765befa26534f7a1242845f89d4abfa.\n\n## Actual previous-session usage\n\n| Source | HTTP attempts | Associated shared robots | Canonical matched observations | Recent verified milestones | Historical candidates |\n|---|---:|---:|---:|---:|---:|\n${table}\n\nAll 500 previous HTTP attempts reconcile; no additional 250 allowance was created. Shared robots attribution is inferred, not an originally recorded source tag. See REVIEW.json for every URL, response and attribution method.\n\n## Research value\n\n- Apex currently has the strongest demonstrated production-update value: one recent, exact-identity, dated application milestone. Its 79 historical backfills are deferred.\n- Wake Forest (4 requests / 106 matched observations), Huntersville (6 / 156), Brunswick County (3 / 69) and Wilmington capital improvements (2 / 35) show efficient identity-checking value; none established a recent publishable change in this review. Matched observations are not independently verified status changes.\n- Structured feeds with stable identifiers, dated action fields and high canonical-match yield are preferred for repeat maintenance. Chapel Hill project pages are valuable for project-specific meeting/decision evidence; agendas alone do not prove decisions.\n- Asheville's initial historical scan consumed 212 attempts and produced no verified recent change in this review. Do not repeat it. The remaining historical observations are cached and not new development discoveries.\n- Raleigh permits remain supporting evidence requiring exact parent matching; issuance is not construction.\n- Union's consolidated feed offers efficient candidate discovery, but missing dates and parent relationships currently limit publishable results.\n- Generic indexes, blocked pages and malformed/scanned PDFs have lower immediate production value; defer them rather than spending the routine session repairing coverage. A source with no change since last week can still be valuable.\n\n## Practical manual routine\n\nStart the weekday skill; resume its queue and reuse semantic fingerprints. Use dated incremental queries with a seven-day overlap and a bounded initial window, retaining active project identities. Process changed/new evidence and upcoming hearings first. Do not infer decisions from edit dates. Keep any discovery gap explicit and preserve its cursor; a short incremental check does not mean full statewide coverage.\n\nNew hard ceilings: eight HTTP attempts per structured source, six per document source, four pages; robots, retries, redirects and PDFs all consume those ceilings. The global authorized session allowance remains independent. Persist source attribution before transport; resume cannot refill a consumed source allowance. A later separately authorized session may continue from its saved cursor.\n\nHistorical backfills remain saved but excluded from the default manual queue. Explicit --include-backfills restores them. Genuine semantic changes, current approvals, upcoming meetings and proposed developments outrank first observations of old records.\n\nThe current live approval bridge is deliberately NC-scoped. California needs a small, separately authorized source set and a narrow generalization of the existing state/approval parameters before live use; it does not need another crawler or backend. For California, begin with a small set of high-value official feeds and known active projects; do not do a broad historical import in a routine maintenance session. Benchmark verified changes and matching yield first, then add the smaller assigned states incrementally. Ten assigned states are a work queue, not a promise of complete coverage in one session. A practical future pilot allowance would be 50 HTTP / 4 searches total, with source limits inside it; a larger 100 HTTP / 8 searches session would need separate approval and demonstrated value. No such limits are authorized or activated now.\n\nUse one exact reviewed batch approval rather than per-request approvals. Routine milestone publication can use existing guarded administrator previews after authorization; standing publication permissions, consequential status changes, archival and mergers remain off. Data-only updates through the existing Supabase save/projection path appear in clients without a new application release. Installed iOS binary verification was not repeated.\n`,{mode:0o600});
 console.log(JSON.stringify({summary:result.summary,preview:out+'/APPROVAL.md',efficiency:out+'/EFFICIENCY.md',topRequestSources:sourceStats.slice(0,8).map(s=>({name:s.jurisdiction,requests:s.requests,recent:s.recentVerifiedMilestones})),productionUnchanged:true}));
