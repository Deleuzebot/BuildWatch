/** Read-only Supabase reconciliation of captured government responses. No publication calls. */
import assert from 'node:assert/strict';import {readFileSync,writeFileSync} from 'node:fs';
import {PostgresDatabase,loadPostgresEnvironment} from '../server/postgres/connection';import {parsePage} from '../server/maintenance/adapters';
import {arcgisReferenceId} from '../server/maintenance/source-identity';import {caryApplicationId} from '../server/research/identifiers';
import {identityText,addressIdentity,raleighEvidence,chapelEvidence} from '../server/maintenance/live-evidence';
import {componentMilestone} from '../server/maintenance/changes';import {pointInOfficialPolygon,proposeStructured} from '../server/maintenance/end-to-end';import {scopeChanged} from '../server/maintenance/evidence-research';
const dir=process.argv[2];if(!dir)throw Error('Use the authorized capture directory');const read=(p:string)=>JSON.parse(readFileSync(p,'utf8')),specs=read(dir+'/sources.json');
const captured=specs.map((s:any)=>{const response=read(dir+'/'+s.key+'-records.json'),data=JSON.parse(response.body);if(s.source.config.pagination==="oid_keyset"){const id=s.source.config.idField||"OBJECTID";data.features.sort((a:any,b:any)=>a.attributes[id]-b.attributes[id]);}return{...s,response,data,findings:parsePage(s.source,JSON.stringify(data),s.size).findings};});
loadPostgresEnvironment();const db=new PostgresDatabase();
try{const result=await db.transaction(async()=>{
 const before=(await db.one('SELECT public.buildwatch_audit_guard() v')).v;assert.deepEqual(before.gates,{writes:false,approved:false,schedule:false});
 const names=captured.flatMap((s:any)=>s.findings.map((f:any)=>f.name.toLowerCase().trim())).filter(Boolean),addresses=captured.flatMap((s:any)=>s.findings.map((f:any)=>f.address.toLowerCase().trim())).filter(Boolean),sourceIds=captured.map((s:any)=>s.source.id),externalIds=captured.flatMap((s:any)=>s.findings.map((f:any)=>f.externalId));
 const refs=await db.rows('SELECT source_id,external_id,buildwatch.bw_canonical(project_id) project_id FROM buildwatch.maintenance_refs WHERE source_id=ANY($1::text[]) AND external_id=ANY($2::text[])',[sourceIds,externalIds]);
 const rows=await db.rows(`SELECT p.id,p.data,p.revision,o.data override,o.revision override_revision,buildwatch.bw_canonical(p.id) canonical_id,EXISTS(SELECT 1 FROM buildwatch.archived_projects a WHERE a.project_id=p.id) archived FROM buildwatch.projects p LEFT JOIN buildwatch.project_overrides o ON o.project_id=p.id WHERE p.id=ANY($1::text[]) OR lower(btrim(p.data::jsonb->>'name'))=ANY($2::text[]) OR lower(btrim(p.data::jsonb->>'address'))=ANY($3::text[]) OR p.data ILIKE ANY($4::text[]) LIMIT 350`,[refs.map(r=>r.project_id),names,addresses,['%Fordham%','%611 Martin%','%611 MLK%','%Salvage%','%Wilson Ball%','%Eastside%']]);
 if(rows.length===350)throw Error('Candidate bound reached; do not infer unmatched identities from an incomplete lookup');
 const projects=rows.filter(r=>r.canonical_id===r.id).map(r=>({...JSON.parse(r.data),...(r.override?JSON.parse(r.override):{}),id:r.id,revision:r.override_revision??r.revision,archived:r.archived}));
 const ids=projects.map(p=>p.id),activities=await db.rows('SELECT * FROM buildwatch.project_activity WHERE project_id=ANY($1::text[])',[ids]),policies=await db.rows('SELECT * FROM buildwatch.approval_policy WHERE project_id=ANY($1::text[])',[ids]),pending=await db.rows("SELECT id,project_id,kind,data,status FROM buildwatch.research_proposals WHERE project_id=ANY($1::text[]) AND status IN('pending','deferred')",[ids]);
 const records:any[]=[];
 for(const s of captured)for(let i=0;i<s.findings.length;i++){
  const f=s.findings[i],feature=s.data.features[i],a=feature.attributes,city=s.key==='chapel'?'Chapel Hill':s.key[0].toUpperCase()+s.key.slice(1);
  const exact=projects.filter(p=>refs.some(r=>r.source_id===s.source.id&&r.external_id===f.externalId&&r.project_id===p.id)||p.sources?.some((v:any)=>arcgisReferenceId(s.source.url,v.url,s.source.config.idField)===f.externalId||(s.key==='cary'&&caryApplicationId(v.url)===f.externalId)));
  const candidates=exact.length?exact:projects.filter(p=>identityText(p.name)===identityText(f.name)&&(!f.address||addressIdentity(p.address)===addressIdentity(f.address))&&identityText(p.jurisdiction||p.city)===identityText(city));
  const p=candidates.length===1?candidates[0]:null,matched=!!p&&!p.archived&&identityText(p.name)===identityText(f.name)&&identityText(p.jurisdiction||p.city)===identityText(city),method=exact.length?'exact_source_identifier':candidates.length?'exact_name_address_jurisdiction':'unmatched';
  const timeline=p?activities.filter(v=>v.project_id===p.id):[],policy=p?policies.find(v=>v.project_id===p.id)||null:null;
  const structured=s.key==='apex'?proposeStructured(f,city,{ids:candidates.map(p=>p.id),project:p,activity:timeline,activityComplete:true},{inside:p&&feature.geometry?.rings?pointInOfficialPolygon(p.latitude,p.longitude,feature.geometry,4326):undefined,source:f.url}):null;const milestone=structured?.proposed.scopedMilestone|| (matched?componentMilestone(f,s.source,p):null),duplicate=milestone&&timeline.some(v=>('key' in milestone&&v.event_key===milestone.key)||(v.event_date===milestone.date&&/approval/i.test(v.type)));
  const awaiting=milestone&&pending.find(v=>v.project_id===p.id&&v.kind==='milestone'&&JSON.stringify(JSON.parse(v.data)).includes(String(milestone.date).slice(0,10)));
  const description=matched&&f.description&&scopeChanged(p.description,f.description)?{before:p.description,after:f.description,evidenceURL:f.url,eventDate:null,reason:'Official narrative contains different numeric scope. Confirm application phase and publication chronology; approval clock unchanged.',requiresReview:true}:null;
  const footprint=p&&feature.geometry?.rings?pointInOfficialPolygon(p.latitude,p.longitude,feature.geometry,4326):undefined;
  const specific=s.key==='raleigh'?raleighEvidence(a):s.key==='chapel'?chapelEvidence(a):null;
  records.push({source:s.key,jurisdiction:city,externalId:f.externalId,sourceURL:f.url,sourceResponseURL:s.response.url,verifiedAt:s.response.retrievedAt||null,name:f.name,description:f.description,address:f.address,rawStatus:f.rawStatus,sourceDates:f.sourceDates,sourceFacts:f.sourceFacts,location:f.locationEvidence,identity:{matched,method,candidateIds:candidates.map(p=>p.id),archivedIdentity:!!p?.archived},before:p?{id:p.id,revision:p.revision,status:p.status,description:p.description,latitude:p.latitude,longitude:p.longitude,approvalPolicy:policy}:null,footprintContainsExistingPin:footprint??null,proposed:{publish:false,archive:false,status:null,location:null,approvalPolicy:null,milestone:milestone&&!duplicate&&!awaiting?milestone:null,description},existingPendingProposal:awaiting?.id||null,duplicateMilestoneSuppressed:!!duplicate,specific,reviewReasons:[...(!matched?['No unique canonical identity verified; do not insert or merge']:[]),...(s.source.config.statusScope!=='development'?['Application or permit status is not whole-development status']:[]),...(s.key==='forsyth'?['Feed has year-only historical decisions; not current maintenance coverage']:[]),...(s.key==='lincoln'?['Overview text and linked application documents require source-specific interpretation']:[]),...(p?.archived?['Archived identity cannot be republished']:[])]});
 }
 const after=(await db.one('SELECT public.buildwatch_audit_guard() v')).v;assert.deepEqual(after,before);
 return{createdAt:new Date().toISOString(),productionUnchanged:true,before,after,candidateProjects:projects,records,summary:{records:records.length,matchedRecords:records.filter(r=>r.identity.matched).length,unmatchedOrConflicted:records.filter(r=>!r.identity.matched).length,proposedMilestones:records.filter(r=>r.proposed.milestone).length,descriptionReviewCandidates:records.filter(r=>r.proposed.description).length,existingPending:records.filter(r=>r.existingPendingProposal).length,duplicateMilestonesSuppressed:records.filter(r=>r.duplicateMilestoneSuppressed).length,excludedMinorPermits:records.filter(r=>r.specific?.eligibility==='excluded_minor_or_ancillary').length,productionWrites:0}};
},true);writeFileSync(dir+'/reconciliation.json',JSON.stringify(result,null,2));console.log(JSON.stringify(result.summary));
}finally{await db.close();}
