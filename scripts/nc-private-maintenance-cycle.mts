 }else if(command==='run'){
  const sources:Source[]=read(dir+'/sources.json'),path=dir+'/cycle.json',state:any=existsSync(path)?read(path):{createdAt:new Date().toISOString(),checkpoint:{done:[],cursors:{}},stats:{},cache:{},findings:{},failures:{},sourceAttempts:{},attempts:[]};
