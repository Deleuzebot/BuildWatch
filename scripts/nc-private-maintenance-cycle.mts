   const newDate=finding.eventDate||finding.sourceDates?.applicationActionAt||finding.sourceDates?.applicationApprovalAt||finding.sourceDates?.applicationStatusAt;const chronologyChanged=newDate&&String(newDate).slice(0,10)!==String(match.project?.sourceStatusDate||'').slice(0,10);
