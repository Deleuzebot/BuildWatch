/** Manual evidence research; credentials can write private shadow metadata, never projects. */
import {mkdirSync,writeFileSync,appendFileSync} from 'node:fs';import assert from 'node:assert/strict';import {PostgresDatabase} from '../server/postgres/connection';import {runEvidenceResearch} from '../server/maintenance/evidence-research';
if(!process.env.CI)process.loadEnvFile('.env.maintenance');if(process.env.BW_SHADOW_LIVE_CHECKS!=='true'||process.env.BW_ALLOW_LIVE_WRITES==='true'||process.env.BW_AI_ENABLED==='true'||process.env.GITHUB_EVENT_NAME==='schedule')throw Error('Explicit manual shadow authorization required; scheduling, writes and AI must be off.');
const db=new PostgresDatabase(),dir='reports/maintenance/evidence-shadow';mkdirSync(dir,{recursive:true});
try{const before=(await db.one('SELECT public.buildwatch_audit_guard() v')).v;const rpc=async(action:string,input:any={})=>(await db.one('SELECT public.buildwatch_shadow($1,$2::jsonb) v',[action,JSON.stringify(input)])).v;
 const result=await runEvidenceResearch(rpc,{key:process.env.GITHUB_RUN_ID||process.env.BW_SHADOW_TEST_KEY||new Date().toISOString(),githubURL:process.env.GITHUB_RUN_ID?'https://github.com/'+process.env.GITHUB_REPOSITORY+'/actions/runs/'+process.env.GITHUB_RUN_ID:undefined,onSnapshot:s=>writeFileSync(dir+'/'+s.sha256+'.json',JSON.stringify(s,null,2))});
 const after=(await db.one('SELECT public.buildwatch_audit_guard() v')).v;assert.deepEqual(after,before);const report={...result,productionUnchanged:true,before,after,publication:false,archival:false,scheduling:false};writeFileSync('reports/maintenance/NC-EVIDENCE-SHADOW.json',JSON.stringify(report,null,2));
 console.log(JSON.stringify({status:result.status,runId:result.runId,stats:result.stats,productionUnchanged:true}));if(process.env.GITHUB_STEP_SUMMARY)appendFileSync(process.env.GITHUB_STEP_SUMMARY,'## Manual NC document/feed shadow trial\n\n```json\n'+JSON.stringify({status:result.status,...result.stats,productionUnchanged:true},null,2)+'\n```\nDetailed sources/proposals remain private in Supabase Automation Management. No public data modified.\n');
 if(result.status==='failed')process.exitCode=1;
}finally{await db.close();}
