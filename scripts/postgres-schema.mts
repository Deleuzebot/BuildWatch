import {DatabaseSync}from'node:sqlite';
import{writeFileSync}from'node:fs';
// Schema is generated from the actual, backed-up database, never assumed models.
const db=new DatabaseSync(process.argv[2]||'../../work/supabase-migration/before-supabase.sqlite',{readOnly:true});
const excluded=(n:string)=>n.startsWith('map_search')||n.startsWith('map_spatial')||n.startsWith('sqlite_');
const tables=(db.prepare("SELECT name,sql FROM sqlite_master WHERE type='table' ORDER BY name").all() as {name:string;sql:string}[]).filter(r=>!excluded(r.name));
const indexes=(db.prepare("SELECT name,sql FROM sqlite_master WHERE type='index' AND sql IS NOT NULL ORDER BY name").all() as {name:string;sql:string}[]).filter(r=>!r.sql.includes('json_extract'));
const header=`-- Generated from BuildWatch SQLite on 2026-10-27. No source data embedded.
CREATE SCHEMA IF NOT EXISTS buildwatch;
REVOKE ALL ON SCHEMA buildwatch FROM PUBLIC;
SET search_path=buildwatch,public;
`;
// Defer FK creation until all tables exist. Preserve millisecond timestamps in BIGINT.
const foreignKeys:string[]=[],definitions:string[]=[];
for(const {name,sql}of tables){
 let ddl=sql.replace(/^CREATE TABLE /,'CREATE TABLE IF NOT EXISTS ').replace(/\bINTEGER\b/g,'BIGINT').replace(/\bREAL\b/g,'DOUBLE PRECISION');
 ddl=ddl.replace(/(\b\w+)\s+(TEXT|BIGINT)((?: NOT NULL| PRIMARY KEY| UNIQUE)*)\s+REFERENCES\s+(\w+)\((\w+)\)(\s+ON DELETE (?:CASCADE|SET NULL))?/g,(_m,col,type,required,target,key,action)=>{foreignKeys.push(`ALTER TABLE "${name}" ADD CONSTRAINT "${name}_${col}_fk" FOREIGN KEY ("${col}") REFERENCES "${target}"("${key}")${action||''} DEFERRABLE INITIALLY DEFERRED;`);return col+' '+type+(required||'');});
 // Stable SQLite rowids preserve public cursors and decision ordering.
 if(['projects','duplicate_decisions'].includes(name))ddl=ddl.replace(/\)\s*$/ ,',rowid BIGINT GENERATED BY DEFAULT AS IDENTITY UNIQUE)');
 definitions.push(ddl+';');
}
const security=tables.map(({name})=>`ALTER TABLE "${name}" ENABLE ROW LEVEL SECURITY;`).join('\n');
writeFileSync('server/postgres/migrations/001-tables.sql',header+definitions.join('\n')+'\n'+foreignKeys.join('\n')+'\n'+indexes.map(r=>r.sql.replace('CREATE INDEX ','CREATE INDEX IF NOT EXISTS ')+';').join('\n')+'\n'+security+`
-- This private schema is deliberately NOT exposed in Supabase Data API.
REVOKE ALL ON ALL TABLES IN SCHEMA buildwatch FROM PUBLIC;
REVOKE ALL ON ALL SEQUENCES IN SCHEMA buildwatch FROM PUBLIC;
ALTER DEFAULT PRIVILEGES IN SCHEMA buildwatch REVOKE ALL ON TABLES FROM PUBLIC;
ALTER DEFAULT PRIVILEGES IN SCHEMA buildwatch REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;
DO $$ BEGIN
 IF EXISTS(SELECT 1 FROM pg_roles WHERE rolname='anon') THEN
  REVOKE ALL ON SCHEMA buildwatch FROM anon;
  REVOKE ALL ON ALL TABLES IN SCHEMA buildwatch FROM anon;
 END IF;
 IF EXISTS(SELECT 1 FROM pg_roles WHERE rolname='authenticated') THEN
  REVOKE ALL ON SCHEMA buildwatch FROM authenticated;
  REVOKE ALL ON ALL TABLES IN SCHEMA buildwatch FROM authenticated;
 END IF;
END $$;
`);
writeFileSync('server/postgres/migration-manifest.json',JSON.stringify({version:1,tables:tables.map(({name})=>({name,columns:(db.prepare('PRAGMA table_info("'+name+'")').all() as any[]).map(c=>c.name),rowid:['projects','duplicate_decisions'].includes(name)}))},null,2));
db.close();console.log(JSON.stringify({tables:tables.length,foreignKeys:foreignKeys.length}));
