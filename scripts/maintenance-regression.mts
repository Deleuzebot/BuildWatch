import assert from'node:assert/strict';
import{readFileSync,writeFileSync}from'node:fs';import{randomUUID}from'node:crypto';
import{loadPostgresEnvironment,PostgresDatabase}from'../server/postgres/connection';
import{deriveProject}from'../server/supabase/derive';import{projects}from'../src/data/projects';
loadPostgresEnvironment();const db=new PostgresDatabase(),checks:string[]=[];let passed=false;
try{await db.transaction(async()=>{
 if(!(await db.one("SELECT to_regclass('buildwatch.maintenance_control') existing")).existing)await db.query(readFileSync('supabase/migrations/20261028213221_nationwide_maintenance.sql','utf8'));
 await db.query(readFileSync('supabase/migrations/20261028214826_maintenance_pilot_hardening.sql','utf8'));
 await db.query(readFileSync('supabase/migrations/20261028215516_maintenance_admin_controls.sql','utf8'));
 const rpc=async(action:string,input:any={})=>(await db.one('SELECT public.buildwatch_maintenance_worker($1,$2::jsonb) value',[action,JSON.stringify(input)])).value;
 async function denied(fn:()=>Promise<any>,pattern=/BW403|permission denied/){await db.query('SAVEPOINT deny');try{await fn();assert.fail('Access unexpectedly allowed');}catch(e:any){assert.match(e.message,pattern);await db.query('ROLLBACK TO SAVEPOINT deny');}await db.query('RELEASE SAVEPOINT deny');}
 const source='fixture-'+randomUUID(),id='maintenance-fixture-'+randomUUID(),uid='owner-fixture-'+randomUUID(),identity={subject:'fixture|'+uid,email:uid+'@example.invalid',verified:true,mfa:true,authenticatedAt:Date.now(),methods:[]};
 await db.query("INSERT INTO buildwatch.users(id,subject,email,name,verified,role,preferences,created) VALUES($1,$2,$3,'Worker fixture owner',1,'admin','{}',$4)",[uid,identity.subject,identity.email,Date.now()]);
 const admin=async(action:string,input:any={})=>(await db.one('SELECT public.buildwatch_maintenance_admin($1::jsonb,$2,$3::jsonb) value',[JSON.stringify(identity),action,JSON.stringify(input)])).value;
 await denied(()=>admin('summary',{}).then(async()=>{await db.query('SELECT public.buildwatch_maintenance_admin($1::jsonb,$2,$3::jsonb)',[JSON.stringify({...identity,mfa:false}),'summary','{}']);}));
 assert.equal((await rpc('claim',{state:'VA',mode:'weekly',dryRun:true,key:'fixture-inactive'})).status,'skipped');
 await denied(()=>rpc('claim',{state:'NC',mode:'weekly',dryRun:false,key:'live-off'}));
 await db.query("INSERT INTO buildwatch.maintenance_sources(id,state,jurisdiction,url,adapter,authority,autopublish,config) VALUES($1,'NC','Fixture','https://example.gov/developments','arcgis','official',true,'{\"scopeVerified\":true,\"statusScope\":\"development\"}')",[source]);
 const dry=await rpc('claim',{state:'NC',mode:'weekly',dryRun:true,key:'fixture-dry'});
 const call=async(action:string,data:any={})=>rpc(action,{runId:dry.run.id,lease:dry.run.lease,...data});
 await denied(()=>rpc('claim',{state:'NC',mode:'weekly',dryRun:true,key:'overlap'}),/BW409/);
 await denied(()=>rpc('checkpoint',{runId:dry.run.id,lease:randomUUID(),checkpoint:{}}),/BW409/);
 const p={...structuredClone(projects[0]),id,revision:0,state:'NC',name:'Fixture Apartments '+id,status:'Under construction',category:'Residential',description:'A 200-unit multifamily housing development.',latitude:35.1234123,longitude:-78.1234123,sources:[{title:'Official fixture',url:'https://example.gov/developments/1'}],meetings:[]};
 const finding={externalId:'1',name:p.name,url:p.sources[0].url,quote:'Construction started 2026-10-01',rawStatus:'construction started',status:'Under construction',eventDate:'2026-10-01'};
 const payload={id:'a'.repeat(64),sourceId:source,finding,project:p,eligible:true,confidence:{method:'fixture'},derived:await deriveProject(p as any)};
 assert.equal((await call('finding',payload)).outcome,'would_publish');assert.equal((await db.one('SELECT count(*) n FROM buildwatch.projects WHERE id=$1',[id])).n,0);
 await call('finish',{status:'completed',stats:{},checkpoint:{}});checks.push('dry-run makes no project writes; inactive states skip, overlapping workers and forged leases are rejected');
 await db.query('UPDATE buildwatch.maintenance_control SET pilot_approved=true,writes_enabled=true WHERE id=1');
 const live=await rpc('claim',{state:'NC',mode:'weekly',dryRun:false,key:'fixture-live'}),apply=async(action:string,data:any={})=>rpc(action,{runId:live.run.id,lease:live.run.lease,...data});
 const key='b'.repeat(64);assert.equal((await apply('finding',{...payload,id:key})).outcome,'published');assert.equal((await apply('finding',{...payload,id:key})).outcome,'unchanged');
 assert.equal((await db.one('SELECT count(*) n FROM buildwatch.history WHERE project_id=$1',[id])).n,1);checks.push('validated live insertion is transactional and idempotent, with one history entry');
 const current=(await db.one('SELECT buildwatch.bw_project($1) value',[id])).value;
 const updated={...current,status:'Approved',sourceStatus:'Approved',sourceStatusDate:'2026-10-02'};
 await apply('finding',{...payload,id:'c'.repeat(64),finding:{...finding,status:'Approved',rawStatus:'Approved',eventDate:'2026-10-02'},project:updated,derived:await deriveProject(updated)});
 await admin('undo',{id:'c'.repeat(64),derived:await deriveProject(current)});assert.equal((await db.one('SELECT buildwatch.bw_project($1) value',[id])).value.status,'Under construction');checks.push('administrator rollback preserves identity and refuses password-only administration');
 await db.query("INSERT INTO buildwatch.archived_projects(project_id,reason,archived_at,actor) VALUES($1,'manual',0,'fixture')",[id]);
 assert.equal((await apply('finding',{...payload,id:'d'.repeat(64),project:{...current,revision:(await db.one('SELECT buildwatch.bw_project($1) value',[id])).value.revision}})).outcome,'excluded_archive');checks.push('archived records cannot be republished by discovery');
 const exp=id+'-expiration';
 const expProject={...p,id:exp,revision:1,status:'Approved'};
 await db.query('INSERT INTO buildwatch.projects(id,data,revision) VALUES($1,$2,1)',[exp,JSON.stringify(expProject)]);
 await db.query("INSERT INTO buildwatch.approval_policy(project_id,approval_date,approval_at,approval_evidence,schedules,expires_at,due_at,actor,updated) VALUES($1,'2020-01-01',1577836800000,'{\"date\":\"2020-01-01\",\"url\":\"https://example.gov/approval\",\"quote\":\"Approved January 1, 2020\"}','[]',1609372800000,1609372800000,'fixture',0)",[exp]);
 await db.query('SELECT buildwatch.bw_refresh($1,$2::jsonb)',[exp,JSON.stringify(await deriveProject(expProject as any))]);
 assert.equal((await apply('expire',{projectId:exp})).outcome,'archived');
 assert.equal((await db.one('SELECT count(*) n FROM buildwatch.map_index WHERE id=$1',[exp])).n,0);
 assert.equal((await db.one('SELECT count(*) n FROM buildwatch.projects WHERE id=$1',[exp])).n,1);
 await db.query('UPDATE buildwatch.approval_policy SET exception_until=$2,due_at=$2 WHERE project_id=$1',[exp,Date.now()+31536000000]);
 assert.equal((await apply('expire',{projectId:exp})).outcome,'protected');
 assert.equal((await db.one("SELECT buildwatch.bw_archive_blocker($1,'restore') value",[exp])).value,'');
 const op=randomUUID(),snapshot=(await db.one('SELECT buildwatch.bw_archive_snapshot($1) value',[exp])).value;
 await db.query("INSERT INTO buildwatch.archive_operations(id,actor,action,scope,status,created,updated,expires,owner) VALUES($1,$2,'restore','{}','running',0,0,9999999999999,$2)",[op,uid]);
 await db.query("INSERT INTO buildwatch.archive_operation_items VALUES($1,$2,$3,'pending','')",[op,exp,snapshot]);
 await db.query('SELECT buildwatch.bw_archive_step($1,$2)',[op,uid]);
 assert.equal((await db.one('SELECT count(*) n FROM buildwatch.map_index WHERE id=$1',[exp])).n,1);
 await db.query("UPDATE buildwatch.project_overrides SET data=jsonb_set(data::jsonb,'{status}','\"In review\"')::text WHERE project_id=$1",[exp]);
 assert.equal((await apply('expire',{projectId:exp})).outcome,'protected');
 checks.push('approved expiration removes only the map projection, future schedules and in-review status are protected, and existing archive recovery restores records after evidence correction');
 await apply('finish',{status:'partially_completed',checkpoint:{done:['one-source'],cursors:{pending:50}},stats:{sourceFailures:1}});
 const resume=await rpc('claim',{state:'NC',mode:'weekly',dryRun:false,key:'fixture-live'});assert.equal(resume.run.checkpoint.cursors.pending,50);checks.push('failed or interrupted cycles resume a persistent checkpoint rather than starting over');
 await db.query('GRANT buildwatch_worker TO postgres');await db.query('SET LOCAL ROLE buildwatch_worker');await db.query("SELECT public.buildwatch_maintenance_worker('states','{}')");await denied(()=>db.query('SELECT * FROM buildwatch.users'));await denied(()=>db.query("SELECT public.buildwatch_maintenance_admin('{}','summary','{}')"));await db.query('RESET ROLE');checks.push('dedicated worker role can only call its scoped RPC, not read accounts or invoke administrator APIs');
 passed=true;throw Error('ROLLBACK_MAINTENANCE_FIXTURE');
});}catch(e:any){if(!passed||e.message!=='ROLLBACK_MAINTENANCE_FIXTURE'){console.error(JSON.stringify({error:e.message,where:e.where,checks}));process.exitCode=1;}}finally{await db.close();}
if(passed){const report={passed,rolledBack:true,checks};writeFileSync('../../work/maintenance-regression.json',JSON.stringify(report,null,2));console.log(JSON.stringify(report));}
