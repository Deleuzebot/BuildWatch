 }
 const assessment=assessGovernmentBenchmark(results);console.log(JSON.stringify({resourceAssessment:assessment}));mkdirSync('reports/maintenance',{recursive:true});writeFileSync('reports/maintenance/pdf50-real-results.json',JSON.stringify({assessment,results},null,2));if(process.env.GITHUB_STEP_SUMMARY)appendFileSync(process.env.GITHUB_STEP_SUMMARY,'## Government PDF resource benchmarks\n\n'+results.map(r=>'- '+r.jurisdiction+': '+r.status+'; '+(r.documents?.[0]?.inputBytes||0)+' bytes; '+(r.documents?.[0]?.processedPages||0)+' pages. '+(r.error||'')).join('\n')+'\n\nResource checks passed: '+assessment.passed+'. Complete source coverage: '+assessment.sourceCoverageComplete+'. Capacity deferrals remain unresolved; no publication. Standard PDF limit remains unchanged.\n');
 if(!assessment.passed)process.exitCode=1;
}finally{await db.close();}
