   const pdf=await extractAgendaPDF(download.rawBody,'planning50'),digest=createHash('sha256').update(download.rawBody).digest('hex');
   const preview=pdf.pages.slice(0,12).map(p=>({page:p.page,text:p.text.slice(0,7000)}));const refs=agendaReferences(pdf,link.url);
   const document={url:link.url,title:link.title,sha256:digest,inputBytes:download.rawBody.length,totalPages:pdf.totalPages,processedPages:pdf.pages.length,truncated:pdf.truncated,metrics:pdf.metrics,references:refs.length};row.documents.push(document);
   await call('finding',{id:hash(['pdf50-real-v1',id,link.url,digest]),sourceId:id,finding:{externalId:digest,name:link.title,url:link.url,quote:pdf.pages[0]?.text.slice(0,2000)||'',recordKind:'pdf_benchmark_evidence',document,previewPages:preview,caseReferences:refs,principalUseVerified:false,locationVerified:false,wholeDevelopment:false},project:{id:'benchmark-'+digest.slice(0,30),state:'NC'},eligible:false,reason:'PDF resource benchmark and extraction preview only; not a verified development or meeting.',confidence:{method:'benchmark_only'}});
   if(pdf.truncated){status='partially_completed';error='Document exceeds processed-page/text envelope; evidence outside the processed portion remains unverified';}
