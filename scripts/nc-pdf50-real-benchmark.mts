const rpc=async(action:string,input:any={})=>(await db.one('SELECT public.buildwatch_maintenance_worker($1,$2::jsonb) value',[action,JSON.stringify(input)])).value;
try{
 const state=await rpc('states');if(state.control.schedule_enabled||state.control.writes_enabled)throw Error('Benchmarks require dry-run gates off');
 for(const id of ids){const claimed=await rpc('claim',{state:'NC',mode:'initial',dryRun:true,key:'pdf50-real:'+(process.env.GITHUB_RUN_ID||'local')+':'+id,githubURL:process.env.GITHUB_RUN_ID?'https://github.com/'+process.env.GITHUB_REPOSITORY+'/actions/runs/'+process.env.GITHUB_RUN_ID:undefined});if(!claimed.run){results.push({sourceId:id,status:claimed.status});continue;}
  const source=claimed.sources.find((s:any)=>s.id===id),run=claimed.run,call=(action:string,input:any={})=>rpc(action,{runId:run.id,lease:run.lease,...input}),budget=new Budget(220,30,100,120_000_000);let status='awaiting_review',error='';const row:any={sourceId:id,jurisdiction:source.jurisdiction,documents:[],capacityDeferrals:[],unexpectedErrors:[],synthetic:false};
  try{const origin=new URL(source.url).origin,http=new SourceHTTP(budget,origin);let policy='';try{policy=(await http.get(origin+'/robots.txt')).body;}catch(e:any){if(!robotsUnavailableAllows(source,e.message))throw e;}
   http.accessPolicy=u=>robotsAllows(policy,u.pathname+u.search);http.minimumInterval=Math.max(1,...[...policy.matchAll(/^crawl-delay:\s*(\d+(?:\.\d+)?)/gim)].map(v=>Number(v[1])))*1000;
