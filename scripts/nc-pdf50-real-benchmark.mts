import {mkdirSync,writeFileSync,readFileSync,appendFileSync} from 'node:fs';import {createHash} from 'node:crypto';import {loadPostgresEnvironment,PostgresDatabase} from '../server/postgres/connection';import {SourceHTTP,DocumentTooLarge} from '../server/maintenance/http';import {Budget,hash} from '../server/maintenance/policy';import {robotsAllows,robotsUnavailableAllows} from '../server/maintenance/worker';import {noticeLinks} from '../server/maintenance/notices';import {extractAgendaPDF,agendaReferences} from '../server/maintenance/agendas';import {assessGovernmentBenchmark} from '../server/maintenance/benchmark-result';
if(!process.env.CI)loadPostgresEnvironment();if(!JSON.parse(readFileSync('reports/maintenance/pdf-50mb-benchmark.json','utf8')).passed)throw Error('Synthetic safety benchmark must pass first');process.env.BW_PDF_50MB_BENCHMARK='true';
