{
  "name": "buildwatch",
  "description": "Explore North Carolina development projects, public meetings, and dated permit records.",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.29.0",
    "@expo/metro-runtime": "~58.0.15",
    "@revenuecat/purchases-js": "^1.73.0",
    "@supabase/supabase-js": "2.118.0",
    "expo": "~58.0.17",
    "expo-auth-session": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "jose": "^6.2.13",
    "leaflet": "1.9.4",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-purchases": "^10.15.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "doctor": "pnpm dlx expo-doctor",
    "export": "expo export --platform ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist-web",
    "build:public": "node scripts/build-public-web.mjs",
    "serve": "tsx server/main.ts",
    "preview": "pnpm export:web && pnpm serve",
    "admin:bootstrap": "tsx server/accounts/bootstrap.ts",
    "data:import:nc": "tsx server/imports/statewide.ts",
    "db:postgres:check": "tsx scripts/postgres-check.mts",
    "db:postgres:rehearse": "tsx scripts/postgres-rehearsal.mts",
    "db:postgres:import": "tsx scripts/postgres-migrate.mts",
    "db:postgres:verify-map": "tsx scripts/postgres-verify-map.mts"
  },
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
