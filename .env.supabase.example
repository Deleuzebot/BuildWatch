# Copy to .env.supabase. This is used only by server-side PostgreSQL tooling.
PGHOST=aws-0-us-east-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.YOUR_PROJECT_REFERENCE
PGPASSWORD=
PGPOOL_MAX=3
PGSSLROOTCERT=server/postgres/supabase-ca.crt
# Do not change the live backend until its complete service port is verified.
