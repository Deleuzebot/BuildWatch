# Public client configuration. No secrets belong in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_BACKEND=supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_WEB_CLIENT_ID=
EXPO_PUBLIC_AUTH0_NATIVE_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=
EXPO_PUBLIC_AUTH0_EMAIL_CONNECTION=Username-Password-Authentication
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_KEY=

# Enable only after configuring and testing the Auth0 Apple connection.
EXPO_PUBLIC_AUTH0_APPLE_ENABLED=false
